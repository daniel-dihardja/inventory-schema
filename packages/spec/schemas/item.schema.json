{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "InventoryItem",
  "type": "object",
  "required": [
    "id",
    "name",
    "quantity",
    "unit",
    "stage_id",
    "stage_props",
    "board_id",
    "board_version",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1 },
    "quantity": { "type": "number", "minimum": 0 },
    "unit": { "type": "string", "enum": ["kg", "g", "L", "ml", "pcs"] },
    "unit_price": { "type": "number", "minimum": 0 },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "pattern": "^[A-Z]{3}$"
    },
    "sku": { "type": "string", "minLength": 1 },
    "lot": { "type": "string", "minLength": 1 },
    "supplier": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "format": "date" },
    "notes": { "type": "string" },
    "stage_id": { "type": "string", "minLength": 1 },
    "stage_props": { "type": "object" },
    "board_id": { "type": "string", "minLength": 1 },
    "board_version": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
